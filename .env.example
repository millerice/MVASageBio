# 交叉审核 runner 配置 —— 复制为 .env 并填写（.env 已 gitignore，绝不提交、绝不贴对话）
#
# 双服务商写法：CROSS_REVIEW_PROVIDER 选择当前用哪家（换家只改这一行），
# 各自的条款确认门（TERMS_ACK）独立——每家的 Processor 条款分开核对后各自放行。

# 当前使用的服务商：deepseek 或 qwen
CROSS_REVIEW_PROVIDER=deepseek

# ── DeepSeek（R2–R5 主力）──
CROSS_DEEPSEEK_BASE_URL=https://api.deepseek.com
CROSS_DEEPSEEK_MODEL=deepseek-chat
CROSS_DEEPSEEK_API_KEY=
# 红线 #3 机器门：核对该服务为 Processor 型（不训练 / 不取得数据权利 / 限时留存）后，
# 把下面的值改为 I_HAVE_VERIFIED，runner 才会真正发请求
CROSS_DEEPSEEK_TERMS_ACK=

# ── 通义千问（DashScope OpenAI 兼容端点，双跑对照用）──
# URL 已含 /v1，runner 不会再补
CROSS_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CROSS_QWEN_MODEL=qwen-max
CROSS_QWEN_API_KEY=
# 条款核对同上，独立放行
CROSS_QWEN_TERMS_ACK=

# ── 智谱 GLM（三角验证用；URL 已含 /v4）──
# 模型名以 docs.bigmodel.cn 模型页为准（当前旗舰 glm-5.3）
CROSS_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
CROSS_GLM_MODEL=glm-5.3
CROSS_GLM_API_KEY=
# 条款核对同上，独立放行
CROSS_GLM_TERMS_ACK=

# 可选：响应 token 上限（默认 16384），随当前 provider 块写
# CROSS_DEEPSEEK_MAX_TOKENS=
# CROSS_QWEN_MAX_TOKENS=

# ── 旧版单块写法（向后兼容）：不设 CROSS_REVIEW_PROVIDER 时生效 ──
# 端点自动补 /v1（以 /v数字 结尾的不再补）。常见：DeepSeek https://api.deepseek.com ·
# 通义 https://dashscope.aliyuncs.com/compatible-mode · GLM https://open.bigmodel.cn/api/paas/v4 ·
# OpenAI https://api.openai.com · 本地 ollama http://localhost:11434
# CROSS_REVIEW_BASE_URL=
# CROSS_REVIEW_MODEL=
# CROSS_REVIEW_API_KEY=
# CROSS_REVIEW_TERMS_ACK=
# CROSS_REVIEW_MAX_TOKENS=
