# 交叉审核 runner 配置 —— 复制为 .env 并填写（.env 已 gitignore，绝不提交、绝不贴对话）

# OpenAI 兼容端点（runner 自动补 /v1；以 /v数字 结尾的不再补）。常见示例：
#   DeepSeek   https://api.deepseek.com
#   通义千问    https://dashscope.aliyuncs.com/compatible-mode
#   GLM        https://open.bigmodel.cn/api/paas/v4
#   OpenAI     https://api.openai.com
#   本地 ollama http://localhost:11434
CROSS_REVIEW_BASE_URL=

# 模型名（以服务商文档为准，例如 deepseek-chat / qwen-max / glm-4.x / gpt-xx）
CROSS_REVIEW_MODEL=

# API 密钥
CROSS_REVIEW_API_KEY=

# 红线 #3 机器门：核对该服务为 Processor 型（不训练 / 不取得数据权利 / 限时留存）后，
# 把下面的值改为 I_HAVE_VERIFIED，runner 才会真正发请求
CROSS_REVIEW_TERMS_ACK=

# 可选：响应 token 上限（默认 16384）
# CROSS_REVIEW_MAX_TOKENS=
